<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="merbah3266.lsposed.start">

    <application
        android:allowBackup="true"
        android:label="LSPosed"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Invisible">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true" />

        <activity-alias
            android:name=".DefaultAlias"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_launcher"
            android:label="LSPosed"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".VectorAlias"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_launcher_vector"
            android:label="Vector"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <service
            android:name=".StartTileService"
            android:label="LSPosed"
            android:icon="@drawable/ic_qs_lsposed"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

        </service>

    </application>

</manifest>