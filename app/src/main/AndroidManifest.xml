<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="merbah3266.lsposed.start">

    <application
        android:allowBackup="true"
        android:label="LSPosed Shortcut"
        android:icon="@drawable/ic_main_icon"
        android:roundIcon="@drawable/ic_main_icon"
        android:theme="@style/Theme.Invisible">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity-alias
            android:name=".LsposedAlias"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_launcher_lsp"
            android:roundIcon="@drawable/ic_launcher_lsp_round"
            android:label="LSPosed"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".VectorAlias"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_launcher_vector"
            android:label="Vector"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".TileLaunchAlias"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:targetActivity=".MainActivity" />

        <service
            android:name=".StartTileService"
            android:label="LSPosed Shortcut"
            android:icon="@drawable/ic_main_icon_monochrome"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

        </service>

    </application>

</manifest>